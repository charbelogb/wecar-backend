generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CarStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RequestStatus {
  NEW
  CONTACTED
  CONVERTED
  CANCELLED
}

model Car {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  brand                String
  model                String
  year                 Int
  city                 String
  category             String
  pricePerDay          Decimal              @map("price_per_day") @db.Decimal(10, 2)
  chauffeurAvailable   Boolean              @default(false) @map("chauffeur_available")
  transmission         String
  fuelType             String               @map("fuel_type")
  seats                Int
  description          String
  mainImageUrl         String               @map("main_image_url")
  pickupZone           String?              @map("pickup_zone")
  depositAmount        Decimal              @map("deposit_amount") @db.Decimal(10, 2)
  rentalPolicy         String?              @map("rental_policy")
  cancellationPolicy   String?              @map("cancellation_policy")
  whatsappPhone        String?              @map("whatsapp_phone")
  status               CarStatus            @default(DRAFT)
  createdAt            DateTime             @default(now()) @map("created_at")
  images               CarImage[]
  reservationRequests  ReservationRequest[]

  @@map("cars")
}

model CarImage {
  id        String @id @default(cuid())
  carId     String @map("car_id")
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")
  car       Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_images")
}

model ReservationRequest {
  id                String        @id @default(cuid())
  carId             String        @map("car_id")
  fullName          String        @map("full_name")
  phone             String
  email             String?
  startDate         DateTime      @map("start_date")
  endDate           DateTime      @map("end_date")
  pickupLocation    String?       @map("pickup_location")
  chauffeurRequired Boolean       @default(false) @map("chauffeur_required")
  message           String?
  status            RequestStatus @default(NEW)
  createdAt         DateTime      @default(now()) @map("created_at")
  car               Car           @relation(fields: [carId], references: [id], onDelete: Restrict)

  @@map("reservation_requests")
}

model CustomRequest {
  id                   String        @id @default(cuid())
  fullName             String        @map("full_name")
  phone                String
  email                String?
  startDate            DateTime?     @map("start_date")
  endDate              DateTime?     @map("end_date")
  city                 String?
  budgetEstimate       Decimal?      @map("budget_estimate") @db.Decimal(10, 2)
  preferredVehicleType String?       @map("preferred_vehicle_type")
  chauffeurRequired    Boolean       @default(false) @map("chauffeur_required")
  message              String?
  status               RequestStatus @default(NEW)
  createdAt            DateTime      @default(now()) @map("created_at")

  @@map("custom_requests")
}
