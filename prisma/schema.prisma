generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum CarStatus {
  DRAFT
  ACTIVE
  UNAVAILABLE
  ARCHIVED
}

enum BookingStatus {
  PENDING
  PAID
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MOCK
}

enum AvailabilitySource {
  ADMIN
  BOOKING
}

model User {
  id           String    @id @default(cuid())
  fullName     String    @map("full_name")
  email        String    @unique
  phone        String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @map("created_at")
  bookings     Booking[]

  @@map("users")
}

model Car {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  title                 String
  brand                 String
  model                 String
  year                  Int
  category              String
  city                  String
  pricePerDay           Decimal             @map("price_per_day") @db.Decimal(10, 2)
  depositAmount         Decimal             @map("deposit_amount") @db.Decimal(10, 2)
  chauffeurAvailable    Boolean             @default(false) @map("chauffeur_available")
  chauffeurPricePerDay  Decimal?            @map("chauffeur_price_per_day") @db.Decimal(10, 2)
  transmission          String
  fuelType              String              @map("fuel_type")
  seats                 Int
  description           String
  mainImageUrl          String              @map("main_image_url")
  status                CarStatus           @default(DRAFT)
  createdAt             DateTime            @default(now()) @map("created_at")
  images                CarImage[]
  bookings              Booking[]
  availabilityBlocks    AvailabilityBlock[]

  @@map("cars")
}

model CarImage {
  id        String @id @default(cuid())
  carId     String @map("car_id")
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")
  car       Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_images")
}

model Booking {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  carId             String        @map("car_id")
  startDate         DateTime      @map("start_date")
  endDate           DateTime      @map("end_date")
  daysCount         Int           @map("days_count")
  pickupLocation    String        @map("pickup_location")
  chauffeurSelected Boolean       @default(false) @map("chauffeur_selected")
  subtotalAmount    Decimal       @map("subtotal_amount") @db.Decimal(10, 2)
  chauffeurAmount   Decimal       @map("chauffeur_amount") @db.Decimal(10, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(10, 2)
  upfrontAmount     Decimal       @map("upfront_amount") @db.Decimal(10, 2)
  remainingAmount   Decimal       @map("remaining_amount") @db.Decimal(10, 2)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  bookingStatus     BookingStatus @default(PENDING) @map("booking_status")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  car               Car           @relation(fields: [carId], references: [id], onDelete: Restrict)
  payments          Payment[]
  availabilityBlock AvailabilityBlock?

  @@map("bookings")
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String          @map("booking_id")
  provider          PaymentProvider
  providerReference String?         @map("provider_reference")
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("XOF")
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?       @map("paid_at")
  rawPayload        Json?           @map("raw_payload")
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model AvailabilityBlock {
  id        String             @id @default(cuid())
  carId     String             @map("car_id")
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  source    AvailabilitySource @default(ADMIN)
  bookingId String?            @unique @map("booking_id")
  note      String?
  car       Car                @relation(fields: [carId], references: [id], onDelete: Cascade)
  booking   Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("availability_blocks")
}
